{
  "expo": {
    "name": "Relatório de Evolução",
    "slug": "Evolucao-de-Pacientes---App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.x0y0dev.EvolucaodePacientesApp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.x0y0dev.EvolucaodePacientesApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2aa52259-0ba5-44d1-91e6-0feb1a4ab307"
      }
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-mail-composer",
      "expo-updates",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite selecionar fotos de pacientes e anexar imagens aos relatórios de evolução.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
