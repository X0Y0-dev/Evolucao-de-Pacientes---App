# Supabase Configuration (React Native / Expo)
# Nomes definidos conforme especificação do projeto:
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_publishable_key_do_supabase

# Convenção Expo para acesso no bundle do cliente:
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sua_publishable_key_do_supabase

# URL do backend OCR (Python/FastAPI)
# Em emulador Android: http://10.0.2.2:8000
# Em aparelho físico: use o IP local da sua máquina (ex: http://192.168.0.15:8000)
# NUNCA use localhost em aparelho físico, pois ele aponta para o próprio celular!
EXPO_PUBLIC_OCR_URL=http://192.168.0.15:8000
