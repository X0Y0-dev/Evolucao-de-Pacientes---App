# ---------------------------------------------------------------------------
# Backend OCR — Variáveis de Ambiente
# ---------------------------------------------------------------------------

# Ambiente da aplicação (development | production)
# Em production, a documentação interativa (/docs, /redoc, /openapi.json) é desativada.
APP_ENV=development
PORT=8000

# Autenticação Supabase (Obrigatórias: o servidor falha ao iniciar se faltarem)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica

# Limite de execuções simultâneas de OCR (evita estouro de memória no container)
OCR_MAX_CONCURRENT=1

# Parâmetros de extração
OCR_MAX_FILE_SIZE=10485760
OCR_MAX_PDF_PAGES=20
OCR_TESSERACT_LANG=por+eng
